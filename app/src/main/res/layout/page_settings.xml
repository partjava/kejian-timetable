<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="match_parent"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <TextView
            style="@style/PageSection"
            android:text="@string/settings_term_section" />
        <include
            android:id="@+id/settings_terms"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_times"
            layout="@layout/item_setting" />
        <TextView
            style="@style/PageSection"
            android:text="@string/settings_display_section" />
        <include
            android:id="@+id/settings_weekends"
            layout="@layout/item_setting_toggle" />
        <include
            android:id="@+id/settings_highlight"
            layout="@layout/item_setting_toggle" />
        <TextView
            style="@style/PageSection"
            android:text="@string/settings_import_section" />
        <include
            android:id="@+id/settings_import"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_ai"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_pending"
            layout="@layout/item_setting" />
        <TextView
            style="@style/PageSection"
            android:text="@string/settings_data_section" />
        <include
            android:id="@+id/settings_unify"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_spread"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_backup"
            layout="@layout/item_setting" />
        <include
            android:id="@+id/settings_restore"
            layout="@layout/item_setting" />
        <TextView
            style="@style/PageCaption"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/settings_footer"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>
</ScrollView>
