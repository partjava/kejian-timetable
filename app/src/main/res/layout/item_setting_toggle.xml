<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_spacing"
    android:padding="@dimen/card_padding"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/page_card">
    <!-- Each include owns these ids; Java finds labels from that row, not the whole page. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/setting_title"
            tools:text="显示周六周日（预览示例）"
            style="@style/PageText"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/setting_detail"
            tools:text="具体内容由 Java 在运行时填入"
            style="@style/PageCaption"
            android:layout_marginTop="6dp" />
    </LinearLayout>
        <Switch
            android:id="@+id/setting_switch"
            android:saveEnabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
