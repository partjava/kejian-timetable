<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_spacing"
    android:padding="@dimen/card_padding"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/page_card">
    <!-- Each include owns these ids; Java finds labels from that row, not the whole page. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/setting_title"
            style="@style/PageText"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/setting_detail"
            style="@style/PageCaption"
            android:layout_marginTop="6dp" />
    </LinearLayout>
    <TextView
        style="@style/PageCaption"
        android:text="@string/setting_chevron"
        android:textSize="22sp" />
</LinearLayout>