<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/page_card"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/term_card_name"
            style="@style/PageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="2026年春季学期" />

        <TextView
            android:id="@+id/term_card_badge"
            style="@style/PageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/page_button_secondary"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textColor="@color/page_primary"
            android:textStyle="bold"
            android:text="@string/term_card_current_badge"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/term_card_weeks"
        style="@style/PageCaption"
        android:layout_width="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        tools:text="共 20 周" />

    <TextView
        android:id="@+id/term_card_start"
        style="@style/PageCaption"
        android:layout_width="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        tools:text="开学日期 2026-03-02" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/term_card_edit"
            style="@style/PageLink"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/term_card_edit" />

        <TextView
            android:id="@+id/term_card_switch"
            style="@style/PageLink"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/term_card_switch" />

        <TextView
            android:id="@+id/term_card_delete"
            style="@style/PageLink"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textColor="@color/color_danger"
            android:text="@string/term_card_delete" />
    </LinearLayout>
</LinearLayout>
